<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-local feed configuration.

  <clear /> is deliberate: developer machines in this org register additional
  feeds (local folder feeds, Visual Studio offline packages). Inheriting them
  makes restore non-reproducible and breaks locked-mode restore.
  See docs/DECISIONS.md D03.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
