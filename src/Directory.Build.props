<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Runtime tuning for server workloads">
    <!--
      API and workers are long-running server processes. Server GC plus
      concurrent background collection keeps p99 latency stable under the
      LLM/tool fan-out described in ARCHITECTURE.md section 11.
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup Label="Global usings">
    <!--
      CA1304/CA1305/CA1307/CA1310/CA1311 are errors here, so essentially every
      file needs CultureInfo.InvariantCulture. Making it global keeps the using
      blocks meaningful instead of boilerplate.
    -->
    <Using Include="System.Globalization" />
  </ItemGroup>

  <PropertyGroup Label="Source generators">
    <!-- Required for the [LoggerMessage] and JsonSerializerContext generators. -->
    <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
  </PropertyGroup>

</Project>
