<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Adapters for every port declared in SreAiAgent.Application: PostgreSQL,
    Kafka, LLM providers, observability backends, registries and security.
  -->

  <ItemGroup>
    <ProjectReference Include="..\SreAiAgent.Application\SreAiAgent.Application.csproj" />
  </ItemGroup>

  <ItemGroup Label="Test visibility">
    <!--
      Adapters are internal: they are implementation details behind the ports in
      SreAiAgent.Application, and nothing outside this assembly should reference
      one directly. Tests are the exception, because a redactor or a schema
      validator has to be tested as the concrete thing it is rather than through
      six layers of indirection.
    -->
    <InternalsVisibleTo Include="SreAiAgent.Infrastructure.Tests" />
    <InternalsVisibleTo Include="SreAiAgent.ContractTests" />
    <InternalsVisibleTo Include="SreAiAgent.IntegrationTests" />
    <InternalsVisibleTo Include="SreAiAgent.SecurityTests" />
    <InternalsVisibleTo Include="SreAiAgent.TestKit" />
    <InternalsVisibleTo Include="SreAiAgent.Evals" />
    <InternalsVisibleTo Include="SreAiAgent.ApiTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup Label="Hosting and options">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup Label="Messaging">
    <PackageReference Include="Confluent.Kafka" />
  </ItemGroup>

  <ItemGroup Label="LLM (docs/DECISIONS.md D09)">
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup Label="Configuration artifacts and schema validation">
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup Label="Observability (shared by API and workers)">
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup Label="Kubernetes read-only observability">
    <PackageReference Include="KubernetesClient" />
  </ItemGroup>

  <!--
    Outbound HTTP to the observability backends (ARCHITECTURE.md 14). Every call
    goes through IHttpClientFactory: `new HttpClient()` is a banned symbol, and a
    named client is what gives each dependency its own resilience pipeline
    instead of one shared policy that suits none of them.
  -->
  <ItemGroup Label="Outbound HTTP">
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

</Project>
