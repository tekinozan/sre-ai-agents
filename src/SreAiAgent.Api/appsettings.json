{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "MigrateOnStartup": false,
    "IncidentDeduplicationWindowMinutes": 60
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "sre-ai-agent-api",
    "MaxInFlightMessages": 100,
    "MaxDeliveryAttempts": 5
  },
  "Llm": {
    "Provider": "scripted",
    "MaxRetries": 2,
    "LogRenderedPrompts": false,
    "ModelNameByProfile": {
      "analytical": "scripted-analytical",
      "fast": "scripted-fast"
    }
  },
  "Registries": {
    "ConfigurationRoot": "config",
    "PromptRoot": "prompts",
    "AgentRelease": "agents-2026.08.25.1",
    "PromptRelease": "sre-prompts-2026.08.25.1",
    "ModelRelease": "models-2026.08.25.1",
    "ToolRelease": "tools-2026.08.25.1",
    "PolicyRelease": "policies-2026.08.25.1",
    "FlagRelease": "flags-2026.08.25.1"
  },
  "Security": {
    "AllowDevelopmentAuthentication": false,
    "MaxRequestBodyBytes": 1048576,
    "RateLimitPerMinute": 600
  },
  "Observability": {
    "UseFakeProviders": true
  },
  "Telemetry": {
    "ServiceName": "sre-ai-api",
    "HttpSamplingRatio": 0.1,
    "EnablePrometheusEndpoint": true
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 100,
    "PollIntervalMilliseconds": 500,
    "MaxAttempts": 8
  },
  "Workflow": {
    "Engine": "temporal",
    "TemporalHostPort": "localhost:7233",
    "TemporalNamespace": "default",
    "TaskQueue": "sre-investigation",
    "DeadlineSeconds": 600,
    "MaxAttempts": 3
  },
  "AgentRuntime": {
  }
}
